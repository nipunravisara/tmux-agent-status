#!/usr/bin/env bash
set -u

command -v tmux >/dev/null 2>&1 || exit 0

max="$(tmux show-option -gqv @agent-status-max 2>/dev/null || true)"
show_idle="$(tmux show-option -gqv @agent-status-show-idle 2>/dev/null || true)"
case "$max" in ''|*[!0-9]*) max=6 ;; esac
[ -n "$show_idle" ] || show_idle=off

count=0
hidden=0
out=""
sep=" #[fg=colour240]│#[default] "

while IFS=$'\t' read -r name agent state unread; do
  [ -n "$state" ] || continue
  if [ "$state" = "idle" ] && [ "$show_idle" != "on" ]; then
    continue
  fi

  if [ "$count" -ge "$max" ]; then
    hidden=$((hidden + 1))
    continue
  fi

  case "$agent" in
    CLAUDE|claude|Claude) a="C" ;;
    CODEX|codex|Codex) a="X" ;;
    *) a="A" ;;
  esac

  case "$state" in
    working) symbol="#[fg=cyan]${a}●#[default]" ;;
    waiting) symbol="#[fg=yellow,bold]${a}!#[default]" ;;
    done)    symbol="#[fg=green,bold]${a}✓#[default]" ;;
    error)   symbol="#[fg=red,bold]${a}×#[default]" ;;
    idle)    symbol="#[fg=colour244]${a}○#[default]" ;;
    *) continue ;;
  esac

  item="#[fg=colour250]${name}#[default] ${symbol}"
  if [ -n "$out" ]; then out+="$sep"; fi
  out+="$item"
  count=$((count + 1))
done < <(tmux list-sessions -F '#{session_name}\t#{@agent_status_agent}\t#{@agent_status_state}\t#{@agent_status_unread}' 2>/dev/null || true)

if [ "$hidden" -gt 0 ]; then
  [ -n "$out" ] && out+="$sep"
  out+="#[fg=colour244]+${hidden}#[default]"
fi

printf '%s' "$out"
