#!/usr/bin/env bash
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
command -v tmux >/dev/null 2>&1 || exit 0
if ! tmux list-sessions >/dev/null 2>&1; then exit 0; fi

needle="  #(\"$ROOT/bin/status-line\")"
for side in status-left status-right; do
  value="$(tmux show-option -gv "$side" 2>/dev/null || true)"
  case "$value" in
    *"$needle"*) tmux set-option -g "$side" "${value//$needle/}" ;;
  esac
done

tmux set-hook -gu 'client-session-changed[100]' 2>/dev/null || true
# Restore tmux's standard Prefix+s chooser. Prefix+A is removed.
tmux bind-key s choose-tree -s 2>/dev/null || true
tmux unbind-key A 2>/dev/null || true
"$ROOT/bin/clear-all" 2>/dev/null || true
tmux refresh-client -S 2>/dev/null || true
